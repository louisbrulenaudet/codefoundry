{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./typescript/strict.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "*.config.ts"],
  "exclude": ["lib"]
}
