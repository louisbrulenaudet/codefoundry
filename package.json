{
  "name": "@codefoundry/tooling-config",
  "description": "CodeFoundry shared tooling policy: Oxlint, oxfmt, Syncpack, Turbo, TypeScript and Vitest presets, Claude Code rules, and the codefoundry CLI.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "bin": {
    "codefoundry": "./bin/codefoundry.js"
  },
  "files": [
    "bin",
    "lib",
    "typescript",
    "claude",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./oxlint": "./lib/oxlint/index.js",
    "./oxfmt": "./lib/oxfmt/index.js",
    "./syncpack": "./lib/syncpack/index.js",
    "./turbo": "./lib/turbo/index.js",
    "./vitest": "./lib/vitest/index.js",
    "./vitest/workers": "./lib/vitest/workers.js",
    "./typescript/strict.json": "./typescript/strict.json",
    "./typescript/library.json": "./typescript/library.json",
    "./typescript/workers.json": "./typescript/workers.json",
    "./typescript/vite-react.json": "./typescript/vite-react.json",
    "./typescript/vite-node.json": "./typescript/vite-node.json",
    "./typescript/tests.json": "./typescript/tests.json",
    "./claude": "./lib/claude/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "ci": "pnpm check-types && pnpm lint && pnpm format:check && pnpm test && pnpm test:pack",
    "codefoundry": "node bin/codefoundry.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm run ci",
    "test": "pnpm build && vitest run",
    "test:pack": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.7.0"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": ">=1.0.0 <2",
    "eslint-plugin-better-tailwindcss": ">=4.7.0 <5",
    "oxfmt": ">=0.65.0 <1",
    "oxlint": ">=1.80.0 <2",
    "oxlint-plugin-react-doctor": ">=0.9.0 <1",
    "oxlint-tsgolint": ">=7.0.2001",
    "syncpack": ">=15.3.0 <16",
    "turbo": ">=2.10.0 <3",
    "typescript": ">=7.0.0 <8",
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-plugin": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-plugin-react-doctor": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "syncpack": {
      "optional": true
    },
    "turbo": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "26.4.0",
    "@types/semver": "^7.7.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "^7.0.2001",
    "syncpack": "^15.3.3",
    "turbo": "2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "claude-code",
    "codefoundry",
    "oxfmt",
    "oxlint",
    "shared-config",
    "syncpack",
    "tsconfig",
    "turborepo",
    "vitest"
  ]
}
